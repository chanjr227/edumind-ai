generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(191)
  password  String   @db.VarChar(255)
  role      UserRole @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi ke seluruh progres lesson yang dimiliki siswa
  lessonProgress LessonProgress[] @relation("StudentLessonProgress")

  // Relasi ke kursus yang dibuat
  courses Course[] @relation("CourseCreator")

  // Relasi ke kursus yang diikuti
  enrollments CourseEnrollment[] @relation("StudentEnrollments")

  // Relasi ke review yang dibuat siswa
  reviews CourseReview[]

  // Relasi ke seluruh sertifikat yang dimiliki siswa
  certificates CourseCertificate[]

  @@map("users")
}

model Course {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(200)
  slug        String       @unique @db.VarChar(220)
  description String       @db.Text
  thumbnail   String?      @db.VarChar(500)
  level       CourseLevel  @default(BEGINNER)
  status      CourseStatus @default(DRAFT)

  createdById Int
  creator     User @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relasi ke seluruh review yang diberikan siswa
  reviews CourseReview[]

  // Relasi ke seluruh sertifikat yang diterbitkan untuk kursus ini
  certificates CourseCertificate[]

  sections    CourseSection[]
  enrollments CourseEnrollment[]

  @@index([createdById])
  @@index([status])
  @@index([level])
  @@map("courses")
}

model CourseEnrollment {
  id        Int @id @default(autoincrement())
  studentId Int
  courseId  Int

  student User   @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrolledAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("course_enrollments")
}

model CourseSection {
  id          Int     @id @default(autoincrement())
  courseId    Int
  title       String  @db.VarChar(200)
  description String? @db.Text
  order       Int     @default(0)

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
  @@index([courseId])
  @@map("course_sections")
}

model CourseLesson {
  id              Int     @id @default(autoincrement())
  sectionId       Int
  title           String  @db.VarChar(200)
  content         String? @db.LongText
  videoUrl        String? @db.VarChar(500)
  durationMinutes Int?
  order           Int     @default(0)
  isPreview       Boolean @default(false)

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi ke progres belajar seluruh siswa pada lesson ini
  progress LessonProgress[]

  @@unique([sectionId, order])
  @@index([sectionId])
  @@map("course_lessons")
}

// Menyimpan progres belajar setiap siswa pada setiap lesson
model LessonProgress {
  // ID unik progres belajar
  id Int @id @default(autoincrement())

  // ID siswa yang sedang mempelajari lesson
  studentId Int

  // ID lesson yang sedang dipelajari
  lessonId Int

  // Menandakan apakah lesson sudah diselesaikan
  isCompleted Boolean @default(false)

  // Waktu ketika lesson diselesaikan
  // Null berarti lesson belum selesai
  completedAt DateTime?

  // Waktu terakhir siswa mengakses lesson
  lastAccessedAt DateTime @default(now())

  // Waktu pembuatan data progres
  createdAt DateTime @default(now())

  // Waktu terakhir data progres diperbarui
  updatedAt DateTime @updatedAt

  // Relasi ke siswa
  student User @relation("StudentLessonProgress", fields: [studentId], references: [id], onDelete: Cascade)

  // Relasi ke lesson
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // Satu siswa hanya memiliki satu progres untuk setiap lesson
  @@unique([studentId, lessonId])
  // Index untuk mempercepat pencarian berdasarkan siswa
  @@index([studentId])
  // Index untuk mempercepat pencarian berdasarkan lesson
  @@index([lessonId])
  // Nama tabel di database MySQL
  @@map("lesson_progress")
}

// Menyimpan review dan rating yang diberikan siswa pada kursus
model CourseReview {
  // ID unik review
  id Int @id @default(autoincrement())

  // ID siswa yang memberikan review
  studentId Int

  // ID kursus yang diberikan review
  courseId Int

  // Rating kursus dari 1 sampai 5 bintang
  rating Int

  // Komentar atau ulasan dari siswa
  comment String? @db.Text

  // Relasi ke siswa
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Relasi ke kursus
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Waktu review dibuat
  createdAt DateTime @default(now())

  // Waktu review diperbarui
  updatedAt DateTime @updatedAt

  // Satu siswa hanya boleh memberikan satu review pada satu kursus
  @@unique([studentId, courseId])
  // Index pencarian berdasarkan siswa
  @@index([studentId])
  // Index pencarian berdasarkan kursus
  @@index([courseId])
  // Nama tabel di database MySQL
  @@map("course_reviews")
}

// Menyimpan sertifikat kelulusan yang diperoleh siswa
model CourseCertificate {
  // ID unik sertifikat
  id Int @id @default(autoincrement())

  // ID siswa yang mendapatkan sertifikat
  studentId Int

  // ID kursus yang telah diselesaikan
  courseId Int

  // Nomor sertifikat unik untuk keperluan verifikasi
  certificateNumber String @unique @db.VarChar(100)

  // Snapshot nama siswa ketika sertifikat diterbitkan
  studentName String @db.VarChar(150)

  // Snapshot judul kursus ketika sertifikat diterbitkan
  courseTitle String @db.VarChar(200)

  // Tanggal siswa menyelesaikan seluruh lesson
  completedAt DateTime

  // Tanggal sertifikat diterbitkan
  issuedAt DateTime @default(now())

  // Relasi ke siswa pemilik sertifikat
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Relasi ke kursus yang diselesaikan
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Satu siswa hanya memperoleh satu sertifikat untuk satu kursus
  @@unique([studentId, courseId])
  // Index untuk pencarian sertifikat berdasarkan siswa
  @@index([studentId])
  // Index untuk pencarian sertifikat berdasarkan kursus
  @@index([courseId])
  // Nama tabel di database MySQL
  @@map("course_certificates")
}
